	column editor_type
		dataType: string
		lineageTag: 7cf22eb2-344d-51c8-a3d1-adc739cb5312
		summarizeBy: none
		sourceColumn: editor_type

		annotation SummarizationSetBy = User

	column is_bot
		dataType: boolean
		lineageTag: 158eea72-a1b7-5225-be11-c953ade5c45c
		summarizeBy: none
		sourceColumn: is_bot

		annotation SummarizationSetBy = User

	column is_anonymous
		dataType: boolean
		lineageTag: 4874525b-7413-52d2-921b-cf49b7b8467a
		summarizeBy: none
		sourceColumn: is_anonymous

		annotation SummarizationSetBy = User

	column registration_ts
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn:ss
		lineageTag: 2d07a3ac-cdde-55e5-afd7-bef1eb348993
		summarizeBy: none
		sourceColumn: registration_ts

		annotation SummarizationSetBy = User

	column first_seen_ts
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn:ss
		lineageTag: 23b1d6dd-7e26-5c1c-b85b-a2c18e6b8928
		summarizeBy: none
		sourceColumn: first_seen_ts

		annotation SummarizationSetBy = User

	column valid_from
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn:ss
		lineageTag: 11edac45-9404-5994-ab90-3b5878cbd568
		summarizeBy: none
		sourceColumn: valid_from

		annotation SummarizationSetBy = User

	column valid_to
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn:ss
		lineageTag: 6bf2e249-8731-512f-a37b-89f327e126c4
		summarizeBy: none
		sourceColumn: valid_to

		annotation SummarizationSetBy = User

	column is_current
		dataType: boolean
		lineageTag: afeb9c57-8b31-506c-bdfb-fe0b993d32b9
		summarizeBy: none
		sourceColumn: is_current

		annotation SummarizationSetBy = User

	partition dim_editor = m
		mode: import
		source =
				let
				    FilePath = SampleFolder & "dim_editor.csv",
				    Content = try Binary.Buffer(File.Contents(FilePath)) otherwise null,
				    Raw = if Content = null then #table({}, {}) else Csv.Document(Content, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars = true]),
				    Result = PrepareTable(Headers, {{"editor_key", "int"}, {"editor_sk", "text"}, {"wiki_key", "int"}, {"wiki", "text"}, {"editor_hash", "text"}, {"editor_type", "text"}, {"is_bot", "bool"}, {"is_anonymous", "bool"}, {"registration_ts", "datetime"}, {"first_seen_ts", "datetime"}, {"valid_from", "datetime"}, {"valid_to", "datetime"}, {"is_current", "bool"}})
				in
				    Result

	annotation PBI_ResultType = Table

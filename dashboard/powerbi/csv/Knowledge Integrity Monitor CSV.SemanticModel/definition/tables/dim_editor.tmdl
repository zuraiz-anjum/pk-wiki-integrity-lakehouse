/// Editors, one row per version (SCD Type 2). Names are salted hashes, bots keep their name.
table dim_editor
	lineageTag: 55c5c4f9-b4e8-5742-b365-b64a4359115d

	column editor_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 1b65c7a4-7778-5be2-868b-5ccd9357cf68
		summarizeBy: none
		sourceColumn: editor_key

		annotation SummarizationSetBy = User

	column editor_sk
		dataType: string
		isHidden
		lineageTag: 60166344-559e-5f95-8417-192096da335b
		summarizeBy: none
		sourceColumn: editor_sk

		annotation SummarizationSetBy = User

	column wiki_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 1a1872a1-e342-58d1-a4b5-32aeb4ac74a2
		summarizeBy: none
		sourceColumn: wiki_key

		annotation SummarizationSetBy = User

	column wiki
		dataType: string
		lineageTag: f5215d3a-5946-57c0-a2be-1d0f5cdcd908
		summarizeBy: none
		sourceColumn: wiki

		annotation SummarizationSetBy = User

	column editor_hash
		dataType: string
		lineageTag: 7bee1cc8-31dc-53fa-b7bb-5305b9050466
		summarizeBy: none
		sourceColumn: editor_hash


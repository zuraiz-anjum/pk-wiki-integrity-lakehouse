	/// Before or after the first temporary account edit we have for that wiki (Q5).
	column 'Temp Account Era' =
			VAR rollout = RELATED ( dim_wiki[temp_accounts_first_seen_ts] )
			RETURN
			    IF (
			        ISBLANK ( rollout ),
			        "No temp accounts yet",
			        IF ( fact_revision[rev_ts] < rollout, "Before temp accounts", "After temp accounts" )
			    )
		dataType: string
		lineageTag: a2c8df57-5f4d-5a2f-b9d6-e96d257e0e10
		summarizeBy: none
		sortByColumn: 'Temp Account Era Order'

		annotation SummarizationSetBy = User

	/// Sort order for Temp Account Era.
	column 'Temp Account Era Order' =
			VAR rollout = RELATED ( dim_wiki[temp_accounts_first_seen_ts] )
			RETURN
			    IF ( ISBLANK ( rollout ), 3, IF ( fact_revision[rev_ts] < rollout, 1, 2 ) )
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 3a393a1e-b528-5183-990b-7a05c0c0265b
		summarizeBy: none

		annotation SummarizationSetBy = User

	partition fact_revision = m
		mode: import
		source =
				let
				    FilePath = SampleFolder & "fact_revision.csv",
				    Content = try Binary.Buffer(File.Contents(FilePath)) otherwise null,
				    Raw = if Content = null then #table({}, {}) else Csv.Document(Content, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars = true]),
				    Result = PrepareTable(Headers, {{"revision_key", "int"}, {"wiki_key", "int"}, {"date_key", "int"}, {"pkt_date_key", "int"}, {"page_key", "int"}, {"editor_key", "int"}, {"change_type_key", "int"}, {"rev_id", "int"}, {"page_id", "int"}, {"parent_rev_id", "int"}, {"reverted_by_rev_id", "int"}, {"rev_ts", "datetime"}, {"rev_ts_pkt", "datetime"}, {"rev_hour_pkt", "int"}, {"bytes", "int"}, {"bytes_diff", "int"}, {"bytes_added", "int"}, {"bytes_removed", "int"}, {"seconds_to_revert", "int"}, {"is_bot_edit", "bool"}, {"is_anonymous_edit", "bool"}, {"is_minor", "bool"}, {"is_page_creation", "bool"}, {"is_new_article", "bool"}, {"is_revert", "bool"}, {"is_reverted", "bool"}, {"is_vandalism_suspect", "bool"}, {"is_deleted", "bool"}, {"source", "text"}})
				in
				    Result

	annotation PBI_ResultType = Table

{
  "name": "pkwiki-lakehouse-daily",
  "max_concurrent_runs": 1,
  "git_source": {
    "git_url": "https://github.com/zuraiz-anjum/pk-wiki-integrity-lakehouse",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "parameters": [
    {"name": "catalog", "default": "workspace"},
    {"name": "prefix", "default": "pkwiki"},
    {"name": "landing_root", "default": ""},
    {"name": "load_type", "default": "incremental"},
    {"name": "snapshot", "default": ""},
    {"name": "start_date", "default": ""},
    {"name": "end_date", "default": ""},
    {"name": "wikis", "default": "all"},
    {"name": "bronze_mode", "default": "append"},
    {"name": "run_id", "default": "{{job.run_id}}"}
  ],
  "tasks": [
    {
      "task_key": "bronze",
      "notebook_task": {
        "notebook_path": "notebooks/01_bronze_ingest",
        "source": "GIT"
      }
    },
    {
      "task_key": "silver",
      "depends_on": [{"task_key": "bronze"}],
      "notebook_task": {
        "notebook_path": "notebooks/02_silver_unify_and_mask",
        "source": "GIT"
      }
    },
    {
      "task_key": "scd2",
      "depends_on": [{"task_key": "silver"}],
      "notebook_task": {
        "notebook_path": "notebooks/03_silver_scd2_and_reverts",
        "source": "GIT"
      }
    },
    {
      "task_key": "gold",
      "depends_on": [{"task_key": "scd2"}],
      "notebook_task": {
        "notebook_path": "notebooks/04_gold_star",
        "source": "GIT"
      }
    }
  ],
  "schedule": {
    "quartz_cron_expression": "0 0 21 * * ?",
    "timezone_id": "UTC",
    "pause_status": "PAUSED"
  }
}
